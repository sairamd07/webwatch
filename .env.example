# WebWatch Environment Configuration
#
# NOTE: In local development and the AI Studio preview environment, ALL of these
# settings are completely optional! WebWatch runs out of the box using:
#  - Built-in persistent SQLite (storage/webwatch.db)
#  - Built-in priority in-process scheduler
#  - Real browser automation & HTTP DOM pipeline
#
# Only configure the variables below when deploying to production with dedicated services.

# Server Port (default 3000)
PORT=3000
NODE_ENV=development

# Database Connection (Optional in local dev)
# Leave empty for local SQLite. Set to a Postgres URI for production deployments:
# DATABASE_URL=postgres://webwatch_user:webwatch_secure_password@localhost:5432/webwatch

# Job Queue Redis Connection (Optional in local dev)
# Leave empty for local in-process scheduler. Set to a Redis URI for production BullMQ:
# REDIS_URL=redis://localhost:6379

# Email Notification Configuration (Optional)
# Leave empty to skip email alerts. Set when you wish to dispatch SMTP emails:
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@your-domain.com
# SMTP_PASS=your-smtp-secret-key
# SMTP_FROM="WebWatch Alerts <alerts@your-domain.com>"

# Telegram Bot API Token (Optional)
# Leave empty to skip Telegram alerts. Set when using Telegram bot notifications:
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Application Public URL (Used for comparison and alert links in emails, Discord, and Telegram)
# Default is http://localhost:3000
# APP_URL=https://your-webwatch-domain.com

